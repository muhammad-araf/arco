# Seed Godown & Processing ERP (arco) — environment template.
# Copy to .env.local for local development. NEVER commit a real .env file
# (the repo .gitignore already excludes .env*). Dummy values below are
# only placeholders so `npx tsc --noEmit` / `npm run build` can run;
# the app fails closed ("Supabase is not configured") until real values
# are set — see SETUP.md.

# Supabase project URL (Project Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon key (Project Settings → API). This key is
# safe to ship in the browser bundle ONLY once the RLS migrations are
# applied (supabase/migration-rls-base-tables.sql and
# supabase/migration-rls-finance-replace.sql, in that order — see
# SETUP.md §2) AND the server actions enforce roles
# (app/actions/auth.ts): the anon key alone authorises nothing, and
# RLS + role gates must both be live and verified in the real project
# before go-live. Until then, treat this key as unprotected.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVICE_ROLE KEY: NOT USED by this app, on purpose. Server actions run
# with the signed-in operator's session (anon client + cookies) so RLS
# and role checks both apply. Do NOT add a service_role key here, and
# NEVER expose one to the browser (NEXT_PUBLIC_*). If a future feature
# genuinely needs service_role (e.g. a back-office import job), it must
# live in a server-only route with its own approval — not in .env.local
# of a developer checkout.
# SUPABASE_SERVICE_ROLE_KEY=
